\definecolor{Blue}{HTML}{0E5AA7}
\definecolor{Gold}{HTML}{C9A227}
\definecolor{SoftGold}{HTML}{F7F1D8}
\definecolor{SoftBlue}{HTML}{EDF4FB}
\definecolor{SoftGray}{HTML}{F4F5F7}
\definecolor{Red}{HTML}{9E2234}
\definecolor{Green}{HTML}{167A68}
\definecolor{TextGray}{HTML}{526170}
\definecolor{CodeBg}{HTML}{F2F4F7}
\definecolor{LineGray}{HTML}{A9B0B7}
\definecolor{Purple}{HTML}{6E4C9A}
\definecolor{Orange}{HTML}{B86416}

%% ------------------------------------------------------------- entête/pied
\newcommand{\NexusHeadRight}{}
\newcommand{\NexusFootLeft}{}
\newcommand{\setnexusheader}[2]{\renewcommand{\NexusHeadRight}{#1}\renewcommand{\NexusFootLeft}{#2}}
\pagestyle{fancy}
\fancyhf{}
%% La marque est une image : les capitales grasses tenaient lieu de logo faute
%% d'un fichier disponible dans le dossier de compilation.
\newcommand{\nexusmark}{%
  \IfFileExists{nexus_logo_mark.png}%
    {\raisebox{-1.1mm}{\includegraphics[height=5.2mm]{nexus_logo_mark.png}}\,}{}%
  \textbf{\color{Navy}NEXUS}\,\textbf{\color{Red}RÉUSSITE}}
\lhead{\nexusmark}
%% Le titre de droite est borné et cadré à droite : sans cette boîte, un intitulé de
%% séance un peu long chevauchait la marque en haut de chaque page.
\rhead{\parbox[b]{0.68\headwidth}{\raggedleft\footnotesize\NexusHeadRight}}
\cfoot{\small \NexusFootLeft \quad | \quad page \thepage/\pageref{LastPage}}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{Gold}\leaders\hrule height \headrulewidth\hfill}}

%% ---------------------------------------------------------------- encadrés
\newtcolorbox{goalbox}{enhanced,breakable,colback=SoftGold,colframe=Gold,boxrule=0.7pt,arc=2mm,left=2.5mm,right=2.5mm,top=1.8mm,bottom=1.8mm}
\newtcolorbox{methodbox}{enhanced,breakable,colback=SoftBlue,colframe=Navy,boxrule=0.7pt,arc=2mm,left=2.5mm,right=2.5mm,top=1.8mm,bottom=1.8mm}
\newtcolorbox{successbox}{enhanced,breakable,colback=green!3,colframe=Green,boxrule=0.7pt,arc=2mm,left=2.5mm,right=2.5mm,top=1.8mm,bottom=1.8mm}
\newtcolorbox{graybox}{enhanced,breakable,colback=SoftGray,colframe=TextGray,boxrule=0.65pt,arc=1.5mm,left=2.5mm,right=2.5mm,top=1.8mm,bottom=1.8mm}
\newtcolorbox{codegoalbox}{enhanced,breakable,colback=purple!3,colframe=Purple,boxrule=0.7pt,arc=2mm,left=2.5mm,right=2.5mm,top=1.8mm,bottom=1.8mm}
\newtcolorbox{warningbox}{enhanced,breakable,colback=orange!4,colframe=Orange,boxrule=0.7pt,arc=2mm,left=2.5mm,right=2.5mm,top=1.8mm,bottom=1.8mm}
\newtcolorbox{keybox}{enhanced,breakable,colback=Red!3,colframe=Red,boxrule=0.7pt,arc=2mm,left=2.5mm,right=2.5mm,top=1.8mm,bottom=1.8mm}

%% Chaque nature de contenu a sa couleur et son onglet. Un document de deux heures
%% alterne définitions, propriétés, méthodes, automatismes, remarques et pièges : sans
%% repère visuel, l'élève qui revient dessus trois semaines plus tard ne distingue plus
%% ce qu'il doit savoir par cœur de ce qu'il doit seulement avoir lu.
\newcommand{\newnexusbox}[4]{%
  \newtcolorbox{#1}{enhanced,breakable,colback=#4,colframe=#3,boxrule=0.7pt,arc=2mm,
    left=2.5mm,right=2.5mm,top=3.4mm,bottom=1.8mm,
    fonttitle=\bfseries\scriptsize\sffamily,coltitle=white,colbacktitle=#3,
    attach boxed title to top left={xshift=3mm,yshift=-2.2mm},
    boxed title style={arc=0.8mm,boxrule=0pt,left=1.6mm,right=1.6mm,top=0.5mm,bottom=0.5mm},
    title={#2}}}

\newnexusbox{definitionbox}{DÉFINITION}{Blue}{SoftBlue}
\newnexusbox{propertybox}{PROPRIÉTÉ}{Navy}{SoftBlue}
\newnexusbox{methodstepbox}{MÉTHODE}{Gold}{SoftGold}
\newnexusbox{reflexbox}{AUTOMATISME}{Green}{green!4}
\newnexusbox{remarkbox}{REMARQUE}{Purple}{purple!3}
\newnexusbox{trapbox}{PIÈGE}{Red}{Red!4}
\newnexusbox{examplebox}{EXEMPLE}{Orange}{orange!5}
\newnexusbox{recallbox}{RAPPEL DE PREMIÈRE}{TextGray}{SoftGray}
\newnexusbox{recallagainbox}{REPRISE}{TextGray}{SoftGray}
\newnexusbox{supportbox}{POINT D'APPUI}{Green}{green!4}

%% Bandeau de séance : durée, thème, piste de l'élève, d'un coup d'œil.
\newcommand{\nexusbandeau}[3]{%
  \begin{tcolorbox}[enhanced,colback=Navy,colframe=Navy,arc=1.6mm,boxrule=0pt,
    left=3mm,right=3mm,top=1.6mm,bottom=1.6mm]
  {\color{white}\bfseries\small #1}\hfill{\color{Gold}\bfseries\small #2}\\[0.4mm]
  {\color{white!82!Navy}\scriptsize #3}
  \end{tcolorbox}\vspace{0.6mm}}

%% Les citations Markdown (« > ») portent dans ce corpus la trace écrite :
%% c'est le contenu que l'élève doit garder. On lui donne l'encadré méthode.
\renewenvironment{quote}{\begin{methodbox}}{\end{methodbox}}

%% ------------------------------------------------------------------ titres
\newcommand{\sectiontitle}[1]{\par\needspace{13mm}\vspace{1mm}{\color{Navy}\Large\bfseries #1}\par\vspace{1mm}{\color{Gold}\rule{\linewidth}{1.1pt}}\vspace{1.5mm}}
\newcommand{\subsectiontitle}[1]{\par\needspace{8mm}\vspace{1mm}{\color{Blue}\large\bfseries #1}\par\vspace{0.8mm}}
\newcommand{\minititle}[1]{\par\needspace{6mm}{\color{Purple}\normalsize\bfseries #1}\par\vspace{0.6mm}}

%% Les titres Markdown passent par les sections LaTeX : on les redessine pour
%% qu'ils reprennent exactement la charte ci-dessus, sans numérotation.
\setcounter{secnumdepth}{0}
\titleformat{\section}{\needspace{13mm}\color{Navy}\Large\bfseries}{}{0pt}{}[{\color{Gold}\rule{\linewidth}{1.1pt}}]
\titleformat{\subsection}{\needspace{9mm}\color{Blue}\large\bfseries}{}{0pt}{}
\titleformat{\subsubsection}{\needspace{7mm}\color{Purple}\normalsize\bfseries}{}{0pt}{}
\titlespacing*{\section}{0pt}{3.2mm}{1.6mm}
\titlespacing*{\subsection}{0pt}{2.6mm}{1.2mm}
\titlespacing*{\subsubsection}{0pt}{2.2mm}{0.9mm}

%% ------------------------------------------------- outils de réponse élève
\newcommand{\conf}{$\square$\,1\quad$\square$\,2\quad$\square$\,3\quad$\square$\,4}
\newcommand{\worklines}[1]{\par\vspace{0.8mm}\foreach \n in {1,...,#1}{\rule{\linewidth}{0.32pt}\par\vspace{5.0mm}}}
\newcommand{\shortlines}[1]{\par\vspace{0.5mm}\foreach \n in {1,...,#1}{\rule{\linewidth}{0.3pt}\par\vspace{3.4mm}}}
\newcommand{\cb}{$\square$}
\newcommand{\answerbox}[1]{\begin{tcolorbox}[colback=white,colframe=LineGray,boxrule=0.45pt,arc=1mm,height=#1,left=2mm,right=2mm,top=1mm,bottom=1mm]\end{tcolorbox}}

%% Ligne de réponse : le corpus Markdown l'écrit en pointillés (« ....... »).
%% À l'impression un filet plein est plus lisible et consomme moins d'encre.
\newcommand{\answerline}{\par\vspace{0.6mm}\noindent\rule{\linewidth}{0.32pt}\par\vspace{2.6mm}}

%% ------------------------------------------------------------------ Python
\lstdefinestyle{nexuscode}{
  basicstyle=\ttfamily\small,
  backgroundcolor=\color{CodeBg},
  frame=single,
  rulecolor=\color{gray!35},
  numbers=none,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  tabsize=4,
  breaklines=true,
  breakatwhitespace=false,
  postbreak=\mbox{\textcolor{TextGray}{$\hookrightarrow$}\space},
  xleftmargin=1mm,
  framexleftmargin=1mm,
  aboveskip=1.5mm,
  belowskip=1.5mm,
  keywordstyle=\color{Blue}\bfseries,
  commentstyle=\color{Green!80!black},
  stringstyle=\color{Red!85!black},
}
%% Les commentaires français passent par inputenc : `literate` n'est pas
%% utilisable ici (dans un .sty il casse les séquences UTF-8 en octets isolés),
%% et la charte S5 déjà en service s'en passe sans dommage.
\lstset{style=nexuscode,language=Python}
\lstnewenvironment{pycode}{\lstset{language=Python}}{}
\lstnewenvironment{sqlcode}{\lstset{language=SQL}}{}

%% -------------------------------------------------- macros disciplinaires
%% Mathématiques : les notations que les trois modules emploient sans arrêt.
%% `\R` et `\C` sont déjà pris par d'autres paquets selon l'ordre de chargement :
%% on écrase délibérément, ces documents n'utilisent pas leur sens d'origine.
\providecommand{\N}{}\renewcommand{\N}{\mathbb{N}}
\providecommand{\Z}{}\renewcommand{\Z}{\mathbb{Z}}
\providecommand{\Q}{}\renewcommand{\Q}{\mathbb{Q}}
\providecommand{\R}{}\renewcommand{\R}{\mathbb{R}}
\providecommand{\C}{}\renewcommand{\C}{\mathbb{C}}
\providecommand{\e}{}\renewcommand{\e}{\mathrm{e}}
\newcommand{\dd}{\mathop{}\!\mathrm{d}}
\newcommand{\ps}[2]{\vv{#1}\cdot\vv{#2}}          % produit scalaire
\newcommand{\norme}[1]{\left\lVert #1 \right\rVert}
\newcommand{\intervalle}[2]{\llbracket #1\,;#2 \rrbracket}

%% ---------------------------------------------------------------- couverture
\newcommand{\nexuscover}[5]{%
\thispagestyle{empty}
\begin{center}
\vspace*{10mm}
\IfFileExists{nexus_logo_slogan.png}%
  {\includegraphics[width=62mm]{nexus_logo_slogan.png}\\[7mm]}%
  {\vspace*{8mm}}
{\color{Gold}\large\bfseries PRÉ-RENTRÉE 2026-2027 \textperiodcentered\ NEXUS RÉUSSITE}\\[6mm]
{\color{Navy}\fontsize{22}{26}\selectfont\bfseries #1}\\[4mm]
{\color{Gold}\rule{0.55\linewidth}{1.4pt}}\\[4mm]
{\large #2}\\[3mm]
%% Le troisième champ peut être vide : la page de garde d'un dossier nominatif porte
%% déjà le nom dans son sous-titre, et le répéter en gros serait un doublon.
\def\nexustitretiers{#3}\ifx\nexustitretiers\empty\else
{\color{Blue}\Large\bfseries #3}\\[6mm]\fi
\end{center}
\begin{graybox}#4\end{graybox}
#5
\vfill
\begin{center}{\color{TextGray}\small Document pédagogique \textperiodcentered\ Nexus Réussite}\end{center}
\clearpage}

%% Bandeau de confidentialité des documents nominatifs.
\newcommand{\nexusconfidentiel}[1]{\begin{keybox}\small\textbf{Document confidentiel.} #1\end{keybox}}

