%% nexus_terminale.sty — charte LaTeX des stages de pré-rentrée Terminale.
%%
%% Reprend sans changement l'identité graphique déjà en service dans le dépôt
%% (S5_release/_common/nexusS5.sty) : mêmes couleurs, mêmes encadrés, mêmes titres.
%% Y sont ajoutés les paquets dont les trois disciplines ont besoin et que la
%% chaîne HTML ne pouvait pas rendre :
%%
%%   mathématiques  amsmath, amssymb, mathtools, esvect (vecteurs à la française),
%%                  pgfplots pour les repères et les courbes ;
%%   physique-chimie siunitx (unités, chiffres, incertitudes) et mhchem/chemfig
%%                  (équations de réaction, formules développées) ;
%%   NSI            listings (Python, SQL) et algorithm2e (pseudo-code).
%%
%% Le document est composé par **LuaLaTeX**, et non par pdflatex comme le reste
%% du dépôt. La raison est mesurable : avec pdflatex, `listings` et `inputenc`
%% se disputent les caractères accentués des commentaires Python et rendent
%% « le tableau doit ê tre é tri » au lieu de « doit être trié » ; ni `literate`
%% ni `extendedchars` ne corrigent la permutation sous TeX Live 2023. LuaLaTeX
%% lit l'UTF-8 nativement et le problème disparaît. Les modules Terminale
%% comportent du code Python et SQL commenté en français : la contrainte est
%% structurelle, pas circonstancielle.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{nexus_terminale}[2026/08/22 Nexus Reussite - charte Terminale]

%% ------------------------------------------------------------------ langue
\RequirePackage{iftex}
\RequireLuaTeX
\RequirePackage{fontspec}
%% Latin Modern : la police déjà en service dans la charte S5 (paquet lmodern),
%% ici dans sa version OpenType pour que LuaLaTeX la charge nativement.
\setmainfont{Latin Modern Roman}
\setsansfont{Latin Modern Sans}
\setmonofont{Latin Modern Mono}[Scale=MatchLowercase]
\RequirePackage[french]{babel}
\RequirePackage{microtype}
\RequirePackage[a4paper,margin=16mm,top=24mm,bottom=20mm,headheight=22pt,headsep=5mm]{geometry}

%% ------------------------------------------------------------ mathématiques
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{mathtools}
\RequirePackage{bm}
\RequirePackage{esvect}      % \vv{u} : la flèche des programmes français
\RequirePackage{stmaryrd}    % \llbracket n \rrbracket : intervalles d'entiers

%% ---------------------------------------------------------- physique-chimie
\RequirePackage{siunitx}
\RequirePackage[version=4]{mhchem}
\RequirePackage{chemfig}
\sisetup{
  locale = FR,                    % virgule décimale, « et » des intervalles
  per-mode = symbol,              % m.s^{-1} plutôt qu'une fraction dans le texte
  separate-uncertainty = true,    % (1,25 +- 0,03) V
  range-phrase = { à },
  range-units = single,
  detect-weight = true,
  detect-family = true,
}
%% Unités courantes au lycée que siunitx ne déclare pas lui-même. `bar` et
%% `electronvolt` sont fournis par siunitx v3 : les redéclarer serait une erreur.
\DeclareSIUnit\molaire{\mole\per\litre}
\DeclareSIUnit\annee{a}

%% -------------------------------------------------------------------- NSI
\RequirePackage{listings}
\RequirePackage[ruled,vlined,linesnumbered]{algorithm2e}

%% ---------------------------------------------------------- mise en page
\RequirePackage[table]{xcolor}
\RequirePackage{tabularx,array,booktabs,longtable,multirow}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
%% titlesec charge titleps, qui refuse de démarrer si \headrule a déjà été
%% redéfini (il ne reconnaît alors plus fancyhdr). Il doit donc être chargé ici,
%% avant la personnalisation de l'entête plus bas.
\RequirePackage{titlesec}
\RequirePackage[most]{tcolorbox}
\RequirePackage{graphicx}
\RequirePackage{lastpage}
\RequirePackage{pgffor}
\RequirePackage{needspace}
\RequirePackage{upquote}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usetikzlibrary{positioning,calc,patterns}
\RequirePackage{hyperref}
\hypersetup{hidelinks,pdfcreator={Nexus Reussite},pdfproducer={pdflatex}}

\setlength{\parindent}{0pt}
\setlength{\parskip}{3.3pt}
\setlist[itemize]{leftmargin=6mm,itemsep=1.1pt,topsep=2pt}
\setlist[enumerate]{leftmargin=7mm,itemsep=1.6pt,topsep=2pt}
\renewcommand{\arraystretch}{1.17}
\sloppy
\raggedbottom

%% Veuves et orphelines : deux lignes seules en haut d'une page, avec le reste de leur
%% paragraphe sur la page précédente, sont le défaut de mise en page le plus visible d'un
%% document imprimé. TeX les évite si on lui en donne le budget.
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000
%% Et il faut lui laisser de quoi rattraper : sans élasticité, il n'a d'autre choix que de
%% renvoyer la ligne à la page suivante.
\setlength{\parskip}{3.3pt plus 1.2pt minus 0.8pt}
%% Les pénalités de veuve ne s'appliquent pas aux listes : c'est un compteur distinct. Sans
%% lui, une liste de matériel se coupait avant son dernier élément, qui partait seul sur la
%% page suivante avec le pied du document. 9999 décourage sans interdire — à 10000, TeX
%% n'aurait plus aucune issue et déplacerait des pages entières.
\makeatletter
\@beginparpenalty=9999
\@itempenalty=9999
\@endparpenalty=9999
\makeatother

%% Le français de babel met une espace fine avant : ; ! ? — mais il ne faut pas
%% qu'elle provoque une coupure de ligne devant un deux-points de consigne.
\frenchsetup{ThinSpaceInFrenchNumbers=true}

