%% ------------------------------------------------------------------ titres
\newcommand{\sectiontitle}[1]{\par\needspace{13mm}\vspace{1mm}{\color{Navy}\Large\bfseries #1}\par\vspace{1mm}{\color{Gold}\rule{\linewidth}{1.1pt}}\vspace{1.5mm}}
\newcommand{\subsectiontitle}[1]{\par\needspace{8mm}\vspace{1mm}{\color{Blue}\large\bfseries #1}\par\vspace{0.8mm}}
\newcommand{\minititle}[1]{\par\needspace{6mm}{\color{Purple}\normalsize\bfseries #1}\par\vspace{0.6mm}}

%% ------------------------------------------------- outils de réponse élève
\newcommand{\conf}{\(\square\,1\quad\square\,2\quad\square\,3\quad\square\,4\)}
\newcommand{\worklines}[1]{\par\vspace{0.8mm}\foreach \n in {1,...,#1}{\rule{\linewidth}{0.32pt}\par\vspace{5.0mm}}}
\newcommand{\shortlines}[1]{\par\vspace{0.5mm}\foreach \n in {1,...,#1}{\rule{\linewidth}{0.3pt}\par\vspace{3.4mm}}}
\newcommand{\cb}{\(\square\)}
\newcommand{\code}[1]{\texttt{\detokenize{#1}}}
%% Ligne « certitude + contrôle » : mise en colonnes, jamais un \hfill dans un
%% paragraphe (qui ne s'étire pas de façon fiable à l'intérieur d'un tcolorbox).
%% Deux lignes distinctes : aucun alignement horizontal fragile.
\newcommand{\certline}{%
\par\vspace{1.2mm}\noindent\textbf{Certitude (1 à 4) :}\quad\conf
\par\vspace{0.8mm}\noindent\textbf{Le contrôle que j'ai utilisé :} \rule{\dimexpr\linewidth-48mm\relax}{0.32pt}
\par\vspace{0.8mm}}
%% Encadré de certitude, avec un libellé explicite.
\newcommand{\certbox}[1]{%
\begin{graybox}
\textbf{#1}\quad\conf
\par\vspace{1mm}
\textbf{Le contrôle que j'ai utilisé :} \rule{\dimexpr\linewidth-52mm\relax}{0.32pt}
\end{graybox}}
%% Ligne d'aide graduée utilisée pendant une phase de travail.
\newcommand{\aideline}{%
\begin{graybox}\small
\textbf{Aide maximale utilisée :}\quad \cb\ aucune \quad \cb\ comprendre \quad
\cb\ identifier \quad \cb\ choisir la méthode \quad \cb\ démarrer
\end{graybox}}
%% Espace de brouillon nettement délimité.
\newcommand{\brouillon}[1]{%
\par\vspace{1.5mm}\begin{tcolorbox}[enhanced,colback=white,colframe=LineGray,boxrule=0.45pt,
arc=1mm,height=#1,left=2mm,right=2mm,top=1mm,bottom=1mm,
title={\small\color{TextGray}Espace de brouillon --- non relevé},
colbacktitle=SoftGray,coltitle=TextGray,fonttitle=\small\bfseries]\end{tcolorbox}}
\newcommand{\answerbox}[1]{\begin{tcolorbox}[colback=white,colframe=LineGray,boxrule=0.45pt,arc=1mm,height=#1,left=2mm,right=2mm,top=1mm,bottom=1mm]\end{tcolorbox}}
\newcommand{\phasehead}[3]{\par\needspace{16mm}{\color{Navy}\Large\bfseries #1}\hfill{\color{Blue}\normalsize\bfseries #2}\par\vspace{1mm}{\color{Gold}\rule{\linewidth}{1.1pt}}\vspace{1mm}\par{\color{TextGray}\small\textit{#3}}\par\vspace{1.5mm}}
\newcommand{\itemhead}[3]{\par\needspace{10mm}{\color{Blue}\bfseries #1}\hfill{\color{TextGray}\small #2 pt --- #3 min}\par\vspace{0.6mm}}

